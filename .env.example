# Copy this file to .env and fill it in. The scripts load .env automatically
# and .env itself is gitignored, so your credentials never reach the repo.
# Variables already set in your shell take precedence over this file.

# Example: STX_EMAIL=you@example.com
STX_EMAIL=
STX_PASSWORD=

# Where to connect. Leave these commented out to use the public US demo
# environment (no real money). Set STX_HOST to override both.
# STX_REGION=us
# STX_ENV=demo
