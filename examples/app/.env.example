# Copy to .env and fill in. Never commit .env.

# Your app's OAuth client, from STX Apps (https://apps.stxapp.io).
STX_OAUTH_CLIENT_ID=stxapp_client_...
STX_OAUTH_CLIENT_SECRET=
# Must match a redirect URI registered on the app exactly.
STX_OAUTH_REDIRECT_URI=http://localhost:8765/callback

# The exchange: US demo by default. STX_HOST (a full URL) overrides both.
STX_REGION=us
STX_ENV=demo
# STX_HOST=

# stx: members sign in with their STX account (one step signs in and connects).
# own: members sign in with this app's own login, then connect their STX account.
LOGIN_MODE=stx

# Optional: the member scopes to ask for (default below).
# MEMBER_SCOPES=profile.read balance.read portfolio.read orders.read orders.write

# Signs the session cookie. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# Encrypts STX tokens at rest (32 bytes, base64). Unset, tokens are stored as they are.
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOKEN_ENCRYPTION_KEY=

# SQLite file for users, tokens and sign-ins in progress.
DATABASE=sample-app.db
